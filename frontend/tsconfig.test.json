{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/app/routing.ts",
    "src/app/routing.test.ts",
    "src/features/auth/types.ts",
    "src/features/auth/components/AuthForm.tsx",
    "src/features/auth/components/AuthForm.test.tsx",
    "src/features/onboarding/types.ts",
    "src/features/onboarding/validation.ts",
    "src/features/onboarding/validation.test.ts",
    "src/features/onboarding/components/OnboardingForm.tsx",
    "src/features/onboarding/components/OnboardingForm.test.tsx",
    "src/features/quests/types.ts",
    "src/features/quests/questErrorFeedback.ts",
    "src/features/quests/questErrorFeedback.test.ts",
    "src/features/quests/questOutcomeErrorFeedback.ts",
    "src/features/quests/questOutcomeValidation.ts",
    "src/features/quests/questOutcome.test.ts",
    "src/features/quests/api/mockQuestOutcomes.ts",
    "src/features/quests/api/questWire.ts",
    "src/features/quests/api/questWire.test.ts",
    "src/features/quests/components/EnergySelector.tsx",
    "src/features/quests/components/QuestRedesignDialog.tsx",
    "src/features/quests/components/QuestCard.tsx",
    "src/features/quests/components/QuestSkeletons.tsx",
    "src/features/quests/components/TodayQuestContent.tsx",
    "src/features/quests/components/TodayQuestContent.test.tsx",
    "src/shared/api/ApiError.ts",
    "src/shared/api/mockApi.ts",
    "src/shared/api/mockApi.quests.test.ts",
    "src/shared/auth/sessionToken.ts",
    "src/shared/auth/sessionToken.test.ts"
  ]
}
