{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/app/routing.ts",
    "src/app/routing.test.ts",
    "src/features/auth/types.ts",
    "src/features/auth/components/AuthForm.tsx",
    "src/features/auth/components/AuthForm.test.tsx",
    "src/features/onboarding/types.ts",
    "src/features/onboarding/validation.ts",
    "src/features/onboarding/validation.test.ts",
    "src/features/onboarding/components/OnboardingForm.tsx",
    "src/features/onboarding/components/OnboardingForm.test.tsx",
    "src/features/dashboard/types.ts",
    "src/features/dashboard/components/DashboardContent.tsx",
    "src/features/dashboard/components/DashboardOverview.tsx",
    "src/features/dashboard/components/DashboardStates.tsx",
    "src/features/dashboard/components/DashboardContent.test.tsx",
    "src/shared/api/mockApi.ts",
    "src/shared/api/mockApi.dashboard.test.ts",
    "src/shared/auth/sessionToken.ts",
    "src/shared/auth/sessionToken.test.ts"
  ]
}
