{
  "name": "restart-quest-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/prepareBuild.mjs && .\\node_modules\\@esbuild\\win32-x64\\esbuild.exe src/main.tsx --bundle --minify --sourcemap --format=esm --outfile=dist/assets/index.js --loader:.tsx=tsx --loader:.ts=ts --loader:.css=css",
    "lint": "eslint . --max-warnings=0",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsc -p tsconfig.test.json && node --test --test-isolation=none \".test-dist/**/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-24.13.2.tgz",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.2.17.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.2.3.tgz",
    "@vitejs/plugin-react": "https://registry.npmjs.org/@vitejs/plugin-react/-/plugin-react-4.7.0.tgz",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "6.4.3"
  },
  "overrides": {
    "acorn": "8.17.0",
    "brace-expansion@1": "1.1.15",
    "ignore": "7.0.5",
    "picomatch": "4.0.4"
  }
}
